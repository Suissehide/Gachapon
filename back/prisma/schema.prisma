datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum OAuthProvider {
  GOOGLE
  DISCORD
}

enum TeamMemberRole {
  MEMBER
  ADMIN
  OWNER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CardRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum CardVariant {
  NORMAL
  BRILLIANT
  HOLOGRAPHIC
}

enum CardElement {
  FIRE
  WATER
  NATURE
  EARTH
  LIGHT
  DARK
}

enum ShopItemType {
  TOKEN_PACK
  ENERGY_PACK
  BOOST
  COSMETIC
  MACHINE
}

enum ShopCurrency {
  DUST
  GOLD
}

enum SkillEffectType {
  REGEN
  LUCK
  DUST_HARVEST
  TOKEN_VAULT
  FREE_PULL_CHANCE
  MULTI_TOKEN_CHANCE
  GOLDEN_BALL_CHANCE
  SHOP_DISCOUNT
  PULL_XP_BONUS
  PITY_BOOST
  VARIANT_LUCK
  DAILY_SHOP_SLOT
  WISHLIST_COOLDOWN
  PC_VAULT
  PC_REGEN
  SWEEP_COST
  GOLD_BONUS
  COMBAT_XP_BONUS
  DROP_BONUS
  UPGRADE_DUST_DISCOUNT
  GOLD_SHOP_DISCOUNT
  DAILY_SHOP_LUCK
}

enum RewardSource {
  STREAK
  ACHIEVEMENT
  QUEST
  LEVEL_UP
  ADMIN
  RAID
}

enum QuestPeriod {
  ONESHOT
  WEEKLY
}

enum EquipmentSlot {
  WEAPON
  ARMOR
  RING       // Anneau
  AMULET     // Amulette  — stat principale PV,       tour NATURE
  GLOVES     // Gants     — stat principale critDmg,  tour FEU
  BOOTS      // Bottes    — stat principale critRate, tour EAU
  BELT       // Ceinture  — stat principale armorPen, tour TERRE
}

/// Les sets sont orthogonaux aux slots : chaque set existe dans les 7 slots.
/// Nommés par identité de build et non par élément, précisément parce qu'ils
/// ne sont pas liés à une tour (une tour droppe un slot, tous sets confondus).
enum EquipmentSet {
  FUREUR
  PRECISION
  PERCEE
  SANGSUE
  // Sets purs : les deux paliers portent la meme stat. CELERITE s'arrete a
  // 2 pieces (pas de palier 4) — voir SetDefinition dans set-bonuses.ts.
  ASSAUT
  COLOSSE
  CELERITE
}

enum ActivityEventType {
  USER_SIGNUP
  PULL_EPIC
  PULL_LEGENDARY
  SHOP_PURCHASE
  USER_SUSPENDED
  USER_UNSUSPENDED
  ADMIN_GRANT
  BULK_REWARD
  LEVEL_UP
}

enum DuelStatus {
  PENDING
  ACTIVE
  SETTLED
  EXPIRED
  DECLINED
  CANCELLED
}

enum BetStatus {
  ACTIVE
  WON
  LOST
  EXPIRED
}

model User {
  id            String     @id @default(uuid())
  username      String     @unique
  email         String     @unique
  passwordHash  String?
  avatar        String?
  banner        String?
  role          GlobalRole @default(USER)
  tokens        Int        @default(0)
  dust          Int        @default(0)
  dustGenerated Int        @default(0)
  lastTokenAt   DateTime?
  xp            Int        @default(0)
  level         Int        @default(1)
  pityCurrent   Int        @default(0)
  streakDays    Int        @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  featuredCardIds String[]   @default([])
  suspended                       Boolean    @default(false)
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?
  passwordResetToken              String?   @unique
  passwordResetTokenExpiresAt     DateTime?

  bestStreak    Int        @default(0)

  gold              Int       @default(0)
  combatPoints      Int       @default(60)
  lastCombatPointAt DateTime?
  combatTeam        String[]  @default([])

  oauthAccounts       OAuthAccount[]
  apiKeys             ApiKey[]
  ownedTeams          Team[]            @relation("TeamOwner")
  teamMemberships     TeamMember[]
  sentInvitations     Invitation[]      @relation("InvitedByUser")
  receivedInvitations Invitation[]      @relation("InvitedUser")
  userCards           UserCard[]
  gachaPulls          GachaPull[]
  purchases           Purchase[]
  achievements             UserAchievement[]
  achievementProgress      UserAchievementProgress[]
  userQuests               UserQuest[]
  skillPoints         Int        @default(0)
  skills              UserSkill[]
  userRewards         UserReward[]
  dailyShops          DailyShop[]

  userEquipment        UserEquipment[]
  campaignProgress     UserCampaignProgress?
  battleResults        BattleResult[]
  towerProgress        UserTowerProgress[]

  wishlistCardId      String?
  wishlistCard        Card?     @relation("UserWishlist", fields: [wishlistCardId], references: [id], onDelete: SetNull)
  wishlistPurchasedAt DateTime?
  boosts              UserBoost[]
  activityEvents      ActivityEvent[]
  raidAttacks         RaidAttack[]
  duelsAsChallenger   Duel[]     @relation("DuelChallenger")
  duelsAsOpponent     Duel[]     @relation("DuelOpponent")
  betsPlaced          Bet[]      @relation("BetBettor")
  betsReceived        Bet[]      @relation("BetTarget")
}

model UserBoost {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Boost de poids : multiplie le dropWeight des cartes de weightRarity
  weightMultiplier Float?
  weightRarity     CardRarity?
  /// Boost de garantie : force le pool guaranteedRarity+ au dernier tirage si non satisfait
  guaranteedRarity CardRarity?
  pullsRemaining   Int
  satisfied        Boolean     @default(false)
  createdAt        DateTime    @default(now())

  @@index([userId])
}

model OAuthAccount {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique
  name       String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Team {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  avatar      String?
  ownerId     String
  owner       User       @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())

  members     TeamMember[]
  invitations Invitation[]
  raids       TeamRaid[]
  duels       Duel[]
  bets        Bet[]

  @@index([ownerId])
}

model TeamMember {
  id       String         @id @default(uuid())
  teamId   String
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id            String           @id @default(uuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedEmail  String?
  invitedUserId String?
  invitedUser   User?            @relation("InvitedUser", fields: [invitedUserId], references: [id])
  invitedById   String?
  invitedBy     User?            @relation("InvitedByUser", fields: [invitedById], references: [id])
  token         String           @unique @default(uuid())
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  emailSentAt   DateTime?
}

model CardSet {
  id          String   @id @default(uuid())
  name        String
  description String?
  coverImage  String?
  hue         Int?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  cards Card[]
}

model Card {
  id         String     @id @default(uuid())
  setId      String
  set        CardSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  name       String
  imageUrl   String?
  rarity     CardRarity
  dropWeight Float      @default(1.0)
  createdAt  DateTime   @default(now())

  baseHp     Int          @default(100)
  baseAtk    Int          @default(10)
  baseDef    Int          @default(5)
  baseSpd    Int          @default(100)
  passiveKey String?
  element    CardElement?

  userCards      UserCard[]
  gachaPulls     GachaPull[]
  dailyShopItems DailyShopItem[]
  wishedBy       User[]        @relation("UserWishlist")
  duelTransfers  DuelTransfer[] @relation("DuelTransferCard")
}

model UserCard {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card        @relation(fields: [cardId], references: [id])
  variant    CardVariant @default(NORMAL)
  quantity   Int         @default(1)
  obtainedAt DateTime    @default(now())

  level     Int @default(1)
  palier    Int @default(1)
  equipment UserEquipment[]

  @@unique([userId, cardId, variant])
}

model Equipment {
  id         String          @id @default(uuid())
  name       String
  slot       EquipmentSlot
  setKey     EquipmentSet
  rarity     CardRarity
  imageUrl   String?
  bonuses    Json
  // Cle de la stat principale, redondante avec l'unique cle de `bonuses`.
  // En colonne parce que Postgres ne sait pas indexer une cle de JSON : c'est
  // elle qui porte l'unicite, donc ce qui autorise plusieurs variantes d'un
  // meme (slot, set, rarete). Valeurs = celles de EquipmentBonuses
  // (combat-stats.domain.ts), pas un enum Prisma pour ne pas dupliquer ce
  // referentiel.
  mainStat   String
  dropWeight Float           @default(1.0)
  userItems  UserEquipment[]

  // Cle naturelle : une piece est identifiee par son emplacement, son set, sa
  // rarete et sa stat principale. Le seed upserte dessus, et les tirages de
  // drop (campagne, tour) la recherchent.
  @@unique([slot, setKey, rarity, mainStat])
}

model UserEquipment {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id])
  equippedOnId String?
  equippedOn   UserCard? @relation(fields: [equippedOnId], references: [id], onDelete: SetNull)
  obtainedAt   DateTime  @default(now())
  level        Int       @default(1)
  substats     Json      @default("[]")
  baseBoost    Float     @default(0)

  @@index([userId])
  @@index([equippedOnId])
}

model GachaPull {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId       String
  card         Card         @relation(fields: [cardId], references: [id])
  variant      CardVariant  @default(NORMAL)
  wasDuplicate Boolean      @default(false)
  dustEarned   Int          @default(0)
  pulledAt     DateTime     @default(now())

  @@index([userId])
  @@index([pulledAt])
  @@index([cardId])
}

model ShopItem {
  id          String       @id @default(uuid())
  name        String
  description String
  type        ShopItemType
  cost        Int
  currency    ShopCurrency @default(DUST)
  value       Json
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItemId  String
  shopItem    ShopItem     @relation(fields: [shopItemId], references: [id])
  amountSpent Int
  currency    ShopCurrency @default(DUST)
  purchasedAt DateTime     @default(now())

  @@index([purchasedAt])
  @@index([userId])
}

model DailyShop {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime        @db.Date
  generatedAt DateTime        @default(now())

  items DailyShopItem[]

  @@unique([userId, date])
  @@index([userId])
}

model DailyShopItem {
  id          String    @id @default(uuid())
  dailyShopId String
  dailyShop   DailyShop @relation(fields: [dailyShopId], references: [id], onDelete: Cascade)
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id])
  dustPrice   Int
  purchased   Boolean   @default(false)
  purchasedAt DateTime?
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  family      String?
  tier        Int      @default(0)
  hidden      Boolean  @default(false)
  iconKey     String?
  criterion   Json
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  rewardId    String?
  reward      Reward?  @relation(fields: [rewardId], references: [id])

  userAchievements UserAchievement[]
  progress         UserAchievementProgress[]

  @@index([family, tier])
  @@index([isActive])
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model UserAchievementProgress {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@unique([userId, achievementId])
  @@index([userId])
}

model Quest {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  description String
  criterion   Json
  period      QuestPeriod @default(ONESHOT)
  rewardId    String?
  reward      Reward?     @relation(fields: [rewardId], references: [id])
  isActive    Boolean     @default(true)

  userQuests UserQuest[]
}

model UserQuest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id])
  periodKey   String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, questId, periodKey])
  @@index([userId, periodKey])
}

model Reward {
  id         String      @id @default(uuid())
  tokens     Int         @default(0)
  dust       Int         @default(0)
  xp         Int         @default(0)
  gold       Int         @default(0)
  cardRarity CardRarity?
  label      String?
  createdAt  DateTime    @default(now())

  streakMilestones StreakMilestone[]
  achievements     Achievement[]
  quests           Quest[]
  userRewards      UserReward[]
  raidTiers        RaidTier[]

  @@map("Rewards")
}

model StreakMilestone {
  id          String  @id @default(uuid())
  day         Int     @unique
  isMilestone Boolean @default(false)
  isActive    Boolean @default(true)
  rewardId    String
  reward      Reward  @relation(fields: [rewardId], references: [id])

  @@map("StreakMilestones")
}

model UserReward {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    Reward       @relation(fields: [rewardId], references: [id])
  source    RewardSource
  sourceId  String?
  claimedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, claimedAt])
  @@index([sourceId])
  @@unique([userId, source, sourceId])
  @@map("UserRewards")
}

model GlobalConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SkillConfig {
  id                Int @id @default(1)
  resetCostPerPoint Int @default(50)
}

model SkillBranch {
  id          String      @id @default(cuid())
  name        String
  description String
  icon        String
  color       String
  order       Int
  nodes       SkillNode[]
}

model SkillNode {
  id          String           @id @default(cuid())
  branchId    String
  branch      SkillBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  description String
  icon        String
  maxLevel    Int
  effectType  SkillEffectType
  posX        Int
  posY        Int
  levels      SkillNodeLevel[]
  edgesFrom   SkillEdge[]      @relation("EdgeFrom")
  edgesTo     SkillEdge[]      @relation("EdgeTo")
  userSkills  UserSkill[]
}

model SkillNodeLevel {
  nodeId String
  level  Int
  effect Float
  node   SkillNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([nodeId, level])
}

model SkillEdge {
  fromNodeId   String
  toNodeId     String
  minLevel     Int       @default(1)
  sourceHandle String?
  targetHandle String?
  fromNode     SkillNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       SkillNode @relation("EdgeTo",   fields: [toNodeId],   references: [id], onDelete: Cascade)

  @@id([fromNodeId, toNodeId])
}

model UserSkill {
  userId String
  nodeId String
  level  Int
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  node   SkillNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
}

model ScoringConfig {
  id                    String   @id @default("singleton")
  commonPoints          Int      @default(1)
  uncommonPoints        Int      @default(3)
  rarePoints            Int      @default(8)
  epicPoints            Int      @default(20)
  legendaryPoints       Int      @default(50)
  brilliantMultiplier   Float    @default(1.5)
  holographicMultiplier Float    @default(2.0)
  updatedAt             DateTime @updatedAt
}

model CampaignStage {
  id        String  @id @default(uuid())
  chapter   Int
  index     Int
  label     String
  isBoss    Boolean @default(false)
  enemyTeam Json
  lootTable Json
  order     Int

  @@unique([chapter, index])
}

model UserCampaignProgress {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  highestChapter Int      @default(1)
  highestIndex   Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/// Un étage d'une tour élémentaire. Calqué sur CampaignStage : mêmes formes
/// de enemyTeam et lootTable, donc mêmes helpers de drop réutilisables.
model TowerFloor {
  id        String      @id @default(uuid())
  element   CardElement // FIRE | WATER | NATURE | EARTH uniquement
  index     Int         // 1..10
  label     String
  enemyTeam Json
  lootTable Json
  order     Int

  @@unique([element, index])
}

model UserTowerProgress {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  element      CardElement
  highestFloor Int         @default(0)
  updatedAt    DateTime    @updatedAt

  @@unique([userId, element])
  @@index([userId])
}

model BattleResult {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId   String?
  seed      String
  won       Boolean
  log       Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ActivityEvent {
  id        String            @id @default(uuid())
  type      ActivityEventType
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  payload   Json?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

/// Boss de raid, un par élément de tour (FIRE/WATER/NATURE/EARTH). `spec` a
/// le même schéma JSON qu'un ennemi de tour (enemySpecSchema, sim-units.ts) :
/// baseHp y est ignoré en combat (PV simulés infinis) mais conservé.
model RaidBoss {
  id        String      @id @default(uuid())
  element   CardElement @unique
  name      String
  spec      Json
  updatedAt DateTime    @updatedAt

  raids TeamRaid[]
}

/// Le raid d'une équipe pour une semaine UTC. Créé paresseusement à la
/// première lecture (raid.domain.ts#ensureRaid), jamais par cron.
model TeamRaid {
  id                 String    @id @default(uuid())
  teamId             String
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  weekKey            String
  bossId             String
  boss               RaidBoss  @relation(fields: [bossId], references: [id])
  maxHp              Int
  hp                 Int
  memberCountAtStart Int
  killedAt           DateTime?
  createdAt          DateTime  @default(now())

  attacks RaidAttack[]

  @@unique([teamId, weekKey])
}

model RaidAttack {
  id          String   @id @default(uuid())
  raidId      String
  raid        TeamRaid @relation(fields: [raidId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  damage      Int
  seed        String
  userCardIds String[]
  createdAt   DateTime @default(now())

  @@index([raidId, userId])
  @@index([userId, createdAt])
}

/// Palier de récompense (25/50/75/100 %), calqué sur StreakMilestone.
model RaidTier {
  id       String @id @default(uuid())
  pct      Int    @unique
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id])
}

/// Un duel de tirage entre deux membres d'une même équipe. Aucun état de
/// progression n'est stocké : les scores et compteurs ci-dessous sont
/// recalculés depuis GachaPull à chaque règlement, et ne servent qu'à
/// l'affichage.
model Duel {
  id              String     @id @default(uuid())
  teamId          String
  team            Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challengerId    String
  challenger      User       @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId      String
  opponent        User       @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status          DuelStatus @default(PENDING)
  pullCount       Int
  createdAt       DateTime   @default(now())
  acceptedAt      DateTime?
  deadlineAt      DateTime?
  settledAt       DateTime?
  winnerId        String?
  /// Scores stockés en DEMI-POINTS (score × 2) : le barème applique un
  /// multiplicateur ×1,5 aux brillantes, qui produit des demi-points.
  challengerScore Int        @default(0)
  opponentScore   Int        @default(0)
  challengerPulls Int        @default(0)
  opponentPulls   Int        @default(0)

  transfers DuelTransfer[]

  @@index([teamId, status])
  @@index([challengerId, status])
  @@index([opponentId, status])
}

/// Trace d'une carte transférée au règlement d'un duel — sert l'historique
/// et l'écran de résultat.
model DuelTransfer {
  id         String      @id @default(uuid())
  duelId     String
  duel       Duel        @relation(fields: [duelId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card        @relation("DuelTransferCard", fields: [cardId], references: [id])
  variant    CardVariant
  fromUserId String
  toUserId   String
  createdAt  DateTime    @default(now())

  @@index([duelId])
}

/// Un pari d'un joueur sur la rareté que sortira un coéquipier. La fenêtre
/// de tirages est relue depuis GachaPull, jamais incrémentée.
model Bet {
  id         String     @id @default(uuid())
  teamId     String
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  bettorId   String
  bettor     User       @relation("BetBettor", fields: [bettorId], references: [id], onDelete: Cascade)
  targetId   String
  target     User       @relation("BetTarget", fields: [targetId], references: [id], onDelete: Cascade)
  stake      Int
  minRarity  CardRarity
  pullWindow Int
  /// Cote figée au placement : jamais recalculée au règlement.
  multiplier Float
  status     BetStatus  @default(ACTIVE)
  createdAt  DateTime   @default(now())
  deadlineAt DateTime
  settledAt  DateTime?
  pullsSeen  Int        @default(0)
  payout     Int        @default(0)

  @@index([teamId, status])
  @@index([bettorId, status])
  @@index([targetId, status])
}
